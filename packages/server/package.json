{
  "name": "@malampu/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --alias:@malampu/shared=../shared/src/index.ts --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/ws-transport": "^0.18.5",
    "@malampu/shared": "workspace:*",
    "compression": "^1.8.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
